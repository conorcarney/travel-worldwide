# Copy to .env.local (never commit secrets).
ATLAS_URI=
# Optional alias if you prefer this name instead of ATLAS_URI:
# MONGODB_URI=
# Atlas database that holds Visited, Flights, etc.
MONGODB_DB=Countries
# Required for Auth.js sessions
AUTH_SECRET=

# Trip photos/videos (admin upload). Use an IAM user with s3:PutObject on trips/*.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront (or custom) origin, no trailing slash:
# AWS_S3_PUBLIC_BASE_URL=https://d111111abcdef8.cloudfront.net
#
# Bucket needs:
# 1) Public GetObject on trips/* (or CloudFront OAC), so the map can load files.
# 2) CORS allowing PUT + Content-Type from http://localhost:3000 and your live origin.
